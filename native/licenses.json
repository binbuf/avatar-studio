      "GPL-2.0-or-later",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "SSPL-1.0",
      "LGPL-2.1-only",
      "LGPL-2.1-or-later",
      "LGPL-3.0-only",
      "LGPL-3.0-or-later",
      "CC-BY-NC-4.0",
      "LicenseRef-Proprietary"
    ],
    "deny_patterns": [
      "(^|[^A-Za-z])GPL-",
      "AGPL",
      "SSPL",
      "^CC-BY-NC",
      "non-?commercial",
      "proprietary"
